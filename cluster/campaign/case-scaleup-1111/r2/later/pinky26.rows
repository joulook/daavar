# case-scaleup-1111 r2 later rows for pinky26 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 9 rows, est 12.3 h on pinky (planning only, R10); tier cinf, mem 80; each join has needok on the export it waits for (placed or running on pinky26); re-exports precede their joins.
# heap -Xmx8g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.omnipaxos.spec_correct_5_0_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export spec --out export.jsonl --threads 16 --model fifo -- correct 5 0 2
C3E.omnipaxos.impl_correct_5_0_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- correct 5 0 2
C3J.omnipaxos.impl_correct_5_0_2_fifo.cinf.m 80 8640000 needok:C3E.omnipaxos.spec_correct_5_0_1_fifo.t16.cinf,C3E.omnipaxos.spec_correct_5_0_2_fifo.t16.cinf.r2,C3E.omnipaxos.impl_correct_5_0_2_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.spec_correct_5_0_2_fifo.t16.cinf.r2/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_correct_5_0_2_fifo.t16.cinf.r2/export.jsonl
C3E.omnipaxos.impl_reorder_5_0_1_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- reorder 5 0 1
C3J.omnipaxos.impl_reorder_5_0_1_fifo.cinf.m 80 8640000 needok:C3E.omnipaxos.spec_correct_5_0_1_fifo.t16.cinf,C3E.omnipaxos.impl_reorder_5_0_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.spec_correct_5_0_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_reorder_5_0_1_fifo.t16.cinf.r2/export.jsonl
C3E.raft-rs.impl_correct_5_0_1_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh raft-rs export impl --out export.jsonl --threads 16 --model fifo -- correct 5 0 1
C3J.raft-rs.impl_correct_5_0_1_fifo.vs-omnipaxos.cinf.m 80 8640000 needok:C3E.omnipaxos.impl_correct_5_0_1_fifo.t16.cinf,C3E.raft-rs.impl_correct_5_0_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.impl_correct_5_0_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.raft-rs.impl_correct_5_0_1_fifo.t16.cinf.r2/export.jsonl
XJE.raft-rs.impl_correct_5_0_1_fifo.w16.cinf.r2 80 8640000 env JAVA_TOOL_OPTIONS=-Xmx8g "$DAAVAR"/scripts/jmc-run.sh raft-rs 'bench.microraft.MicroRaft:impl,correct,5,0,1' must 0 1 export.jsonl 8640000 --split 16 --k 1
XC1.raft-rs.impl_correct_5_0_1_fifo.vs-omnipaxos.jimpl-tfimpl.cinf.m 80 8640000 needok:C3E.omnipaxos.impl_correct_5_0_1_fifo.t16.cinf,XJE.raft-rs.impl_correct_5_0_1_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.impl_correct_5_0_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XJE.raft-rs.impl_correct_5_0_1_fifo.w16.cinf.r2/export.jsonl
