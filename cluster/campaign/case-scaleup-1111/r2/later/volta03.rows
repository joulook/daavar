# case-scaleup-1111 r2 later rows for volta03 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 2 rows, est 0.1 h on volta (planning only, R10); tier cinf, mem 200; each join has needok on the export it waits for (placed or running on volta03); re-exports precede their joins.
# heap -Xmx16g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
XCE.cassandra-rr.impl_3_none_fifo.w16.cinf.r2 200 8640000 env JAVA_TOOL_OPTIONS=-Xmx16g "$DAAVAR"/scripts/jmc-run.sh cf-cassandra-rr 'bench.cassandra_rr.CassandraReadRepair:impl,3,none,fifo' must 0 1 export.jsonl 8640000 --split 16 --k 1
XC2.cassandra-rr.impl_3_none_fifo.vs-rust-sol.tfimpl-jimpl.cinf.m 200 8640000 needok:C3E.cassandra-rr-rust-sol.impl_3_none_fifo.t16.cinf,XCE.cassandra-rr.impl_3_none_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-rust-sol.impl_3_none_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr.impl_3_none_fifo.w16.cinf.r2/export.jsonl
