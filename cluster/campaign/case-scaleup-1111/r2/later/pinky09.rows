# case-scaleup-1111 r2 later rows for pinky09 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 7 rows, est 1.2 h on pinky (planning only, R10); tier cinf, mem 80; each join has needok on the export it waits for (placed or running on pinky09); re-exports precede their joins.
# heap -Xmx8g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.omnipaxos.spec_correct_2_2_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export spec --out export.jsonl --threads 16 --model fifo -- correct 2 2 2
C3E.omnipaxos.impl_correct_2_2_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- correct 2 2 2
C3J.omnipaxos.impl_correct_2_2_2_fifo.cinf.m 80 8640000 needok:C3E.omnipaxos.spec_correct_1_2_2_fifo.t16.cinf,C3E.omnipaxos.spec_correct_2_2_2_fifo.t16.cinf.r2,C3E.omnipaxos.impl_correct_2_2_2_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.spec_correct_2_2_2_fifo.t16.cinf.r2/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_correct_2_2_2_fifo.t16.cinf.r2/export.jsonl
C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- correct 1 2 2
C3J.omnipaxos.impl_correct_1_2_2_fifo.vs-derived.cinf.m 80 8640000 needok:C3E.omnipaxos-derived.spec_correct_1_2_2_fifo.t16.cinf,C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos-derived.spec_correct_1_2_2_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r2/export.jsonl
C3E.omnipaxos.impl_reorder_1_2_2_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- reorder 1 2 2
C3J.omnipaxos.impl_reorder_1_2_2_fifo.cinf.m 80 8640000 needok:C3E.omnipaxos.spec_correct_1_2_2_fifo.t16.cinf,C3E.omnipaxos.impl_reorder_1_2_2_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos.spec_correct_1_2_2_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_reorder_1_2_2_fifo.t16.cinf.r2/export.jsonl
