# case-scaleup-1111 r2 later rows for volta12 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 6 rows, est 5.8 h on volta (planning only, R10); tier cinf, mem 200; each join has needok on the export it waits for (placed or running on volta12); re-exports precede their joins.
# heap -Xmx16g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.crdb-pc-rust.impl_2_2_2_1_fifo.t16.cinf.r2 200 8640000 "$DAAVAR"/scripts/rust-run.sh crdb-pc-rust export impl --out export.jsonl --threads 16 --model fifo -- 2 2 2 1
C3J.crdb-pc-rust.impl_2_2_2_1_fifo.vs-pc-rust-sol.cinf.m 200 8640000 needok:C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf,C3E.crdb-pc-rust.impl_2_2_2_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.crdb-pc-rust.impl_2_2_2_1_fifo.t16.cinf.r2/export.jsonl
XC1.crdb-pc.impl_2_2_2_1_fifo.vs-pc-rust-sol.jimpl-tfimpl.cinf.m 200 8640000 needok:XCE.crdb-pc.impl_2_2_2_1_fifo.w1.cinf,C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XCE.crdb-pc.impl_2_2_2_1_fifo.w1.cinf/export.jsonl "$EVAL_OUT"/C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf/export.jsonl
XC1.crdb-pc.impl_2_2_2_1_fifo.vs-pc-rust.jimpl-tfimpl.cinf.m 200 8640000 needok:XCE.crdb-pc.impl_2_2_2_1_fifo.w1.cinf,C3E.crdb-pc-rust.impl_2_2_2_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XCE.crdb-pc.impl_2_2_2_1_fifo.w1.cinf/export.jsonl "$EVAL_OUT"/C3E.crdb-pc-rust.impl_2_2_2_1_fifo.t16.cinf.r2/export.jsonl
XCE.crdb-pc-sol.impl_2_2_2_1_fifo.w16.cinf.r2 200 8640000 env JAVA_TOOL_OPTIONS=-Xmx16g "$DAAVAR"/scripts/jmc-run.sh cf-crdb-pc-sol 'bench.cockroach_sol.ParallelCommits:impl,2,2,2,1,fifo' must 0 1 export.jsonl 8640000 --split 16 --k 1
XC2.crdb-pc-sol.impl_2_2_2_1_fifo.tfimpl-jimpl.cinf.m 200 8640000 needok:C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf,XCE.crdb-pc-sol.impl_2_2_2_1_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.crdb-pc-rust-sol.impl_2_2_2_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.crdb-pc-sol.impl_2_2_2_1_fifo.w16.cinf.r2/export.jsonl
