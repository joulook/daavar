# case-scaleup-1111 r2 later rows for pinky10 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 9 rows, est 0.4 h on pinky (planning only, R10); tier cinf, mem 80; each join has needok on the export it waits for (placed or running on pinky10); re-exports precede their joins.
# heap -Xmx8g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.cassandra-rr-rust.impl_4_blocking_fifo.t16.cinf.r2 80 8640000 "$DAAVAR"/scripts/rust-run.sh cassandra-rr-rust export impl --out export.jsonl --threads 16 --model fifo -- 4 blocking
C3J.cassandra-rr-rust.impl_4_blocking_fifo.vs-derived.cinf.m 80 8640000 needok:C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf,C3E.cassandra-rr-rust.impl_4_blocking_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.cassandra-rr-rust.impl_4_blocking_fifo.t16.cinf.r2/export.jsonl
C3J.cassandra-rr-rust.impl_4_blocking_fifo.vs-hand.cinf.m 80 8640000 needok:C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf,C3E.cassandra-rr-rust.impl_4_blocking_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.cassandra-rr-rust.impl_4_blocking_fifo.t16.cinf.r2/export.jsonl
XCE.cassandra-rr-sol.impl_4_blocking_fifo.w16.cinf.r2 80 8640000 env JAVA_TOOL_OPTIONS=-Xmx8g "$DAAVAR"/scripts/jmc-run.sh cf-cassandra-rr-sol 'bench.cassandra_rr_sol.CassandraReadRepair:impl,4,blocking,fifo' must 0 1 export.jsonl 8640000 --split 16 --k 1
XJ1.cassandra-rr-sol.impl_4_blocking_fifo.vs-derived.tfspec-jmcimpl.cinf.m 80 8640000 needok:C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf,XCE.cassandra-rr-sol.impl_4_blocking_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr-sol.impl_4_blocking_fifo.w16.cinf.r2/export.jsonl
XJ1.cassandra-rr-sol.impl_4_blocking_fifo.vs-hand.tfspec-jmcimpl.cinf.m 80 8640000 needok:C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf,XCE.cassandra-rr-sol.impl_4_blocking_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr-sol.impl_4_blocking_fifo.w16.cinf.r2/export.jsonl
XCE.cassandra-rr.impl_4_blocking_fifo.w16.cinf.r3 80 8640000 env JAVA_TOOL_OPTIONS=-Xmx8g "$DAAVAR"/scripts/jmc-run.sh cf-cassandra-rr 'bench.cassandra_rr.CassandraReadRepair:impl,4,blocking,fifo' must 0 1 export.jsonl 8640000 --split 16 --k 1
XJ1.cassandra-rr.impl_4_blocking_fifo.vs-derived.tfspec-jmcimpl.cinf.m 80 8640000 needok:C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf,XCE.cassandra-rr.impl_4_blocking_fifo.w16.cinf.r3 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-derived.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr.impl_4_blocking_fifo.w16.cinf.r3/export.jsonl
XJ1.cassandra-rr.impl_4_blocking_fifo.vs-hand.tfspec-jmcimpl.cinf.m 80 8640000 needok:C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf,XCE.cassandra-rr.impl_4_blocking_fifo.w16.cinf.r3 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr.spec_4_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr.impl_4_blocking_fifo.w16.cinf.r3/export.jsonl
