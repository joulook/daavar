# case-scaleup-1111 r2 later rows for brain01 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 4 rows, est 4.4 h on brain (planning only, R10); tier cinf, mem 250; each join has needok on the export it waits for (placed or running on brain01); re-exports precede their joins.
# heap -Xmx12g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r3 250 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- correct 1 2 2
C3J.omnipaxos.impl_correct_1_2_2_fifo.vs-raft-rs.cinf.m 250 8640000 needok:C3E.raft-rs.impl_correct_1_2_2_fifo.t16.cinf,C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r3 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.raft-rs.impl_correct_1_2_2_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_correct_1_2_2_fifo.t16.cinf.r3/export.jsonl
XJE.raft-rs.spec_correct_1_2_2_fifo.w16.cinf.r2 250 8640000 env JAVA_TOOL_OPTIONS=-Xmx12g "$DAAVAR"/scripts/jmc-run.sh raft-rs 'bench.microraft.MicroRaft:spec,correct,1,2,2' must 0 1 export.jsonl 8640000 --split 16 --k 1
XJ2.raft-rs.impl_correct_1_2_2_fifo.jmcspec-tfimpl.cinf.m 250 8640000 needok:C3E.raft-rs.impl_correct_1_2_2_fifo.t16.cinf,XJE.raft-rs.spec_correct_1_2_2_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XJE.raft-rs.spec_correct_1_2_2_fifo.w16.cinf.r2/export.jsonl "$EVAL_OUT"/C3E.raft-rs.impl_correct_1_2_2_fifo.t16.cinf/export.jsonl
