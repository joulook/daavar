# case-scaleup-1111 r2 later rows for brain15 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 6 rows, est 41.1 h on brain (planning only, R10); tier cinf, mem 250; each join has needok on the export it waits for (placed or running on brain15); re-exports precede their joins.
# heap -Xmx12g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.cassandra-rr-rust.impl_3_blocking_fifo.t16.cinf.r2 250 8640000 "$DAAVAR"/scripts/rust-run.sh cassandra-rr-rust export impl --out export.jsonl --threads 16 --model fifo -- 3 blocking
C3J.cassandra-rr-rust.impl_3_blocking_fifo.vs-rust-sol.cinf.m 250 8640000 needok:C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf,C3E.cassandra-rr-rust.impl_3_blocking_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.cassandra-rr-rust.impl_3_blocking_fifo.t16.cinf.r2/export.jsonl
XC1.cassandra-rr-sol.impl_3_blocking_fifo.jimpl-tfimpl.cinf.m 250 8640000 needok:XCE.cassandra-rr-sol.impl_3_blocking_fifo.w16.cinf,C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XCE.cassandra-rr-sol.impl_3_blocking_fifo.w16.cinf/export.jsonl "$EVAL_OUT"/C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf/export.jsonl
XC2.cassandra-rr-sol.impl_3_blocking_fifo.tfimpl-jimpl.cinf.m 250 8640000 needok:C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf,XCE.cassandra-rr-sol.impl_3_blocking_fifo.w16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr-sol.impl_3_blocking_fifo.w16.cinf/export.jsonl
XCE.cassandra-rr.impl_3_blocking_fifo.w16.cinf.r2 250 8640000 env JAVA_TOOL_OPTIONS=-Xmx12g "$DAAVAR"/scripts/jmc-run.sh cf-cassandra-rr 'bench.cassandra_rr.CassandraReadRepair:impl,3,blocking,fifo' must 0 1 export.jsonl 8640000 --split 16 --k 1
XC2.cassandra-rr.impl_3_blocking_fifo.vs-rust-sol.tfimpl-jimpl.cinf.m 250 8640000 needok:C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf,XCE.cassandra-rr.impl_3_blocking_fifo.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.cassandra-rr-rust-sol.impl_3_blocking_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.cassandra-rr.impl_3_blocking_fifo.w16.cinf.r2/export.jsonl
