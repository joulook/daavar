# case-scaleup-1111 r2 later rows for volta05 (coordinator 2026-11-11: duplicate exports accepted when they enable a new join); generated by scripts/case-scaleup-1111-r2/later.py; 4 rows, est 8.2 h on volta (planning only, R10); tier cinf, mem 200; each join has needok on the export it waits for (placed or running on volta05); re-exports precede their joins.
# heap -Xmx16g for JMC exports; at most one JMC export at a time on a pinky or volta, three on a brain
C3E.omnipaxos.impl_correct_2_3_1_fifo.t16.cinf.r2 200 8640000 "$DAAVAR"/scripts/rust-run.sh omnipaxos export impl --out export.jsonl --threads 16 --model fifo -- correct 2 3 1
C3J.omnipaxos.impl_correct_2_3_1_fifo.vs-derived.cinf.m 200 8640000 needok:C3E.omnipaxos-derived.spec_correct_2_3_1_fifo.t16.cinf,C3E.omnipaxos.impl_correct_2_3_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos-derived.spec_correct_2_3_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.omnipaxos.impl_correct_2_3_1_fifo.t16.cinf.r2/export.jsonl
C3E.raft-rs.impl_correct_2_3_1_fifo.t16.cinf.r2 200 8640000 "$DAAVAR"/scripts/rust-run.sh raft-rs export impl --out export.jsonl --threads 16 --model fifo -- correct 2 3 1
C3J.raft-rs.impl_correct_2_3_1_fifo.vs-omni.cinf.m 200 8640000 needok:C3E.omnipaxos-derived.spec_correct_2_3_1_fifo.t16.cinf,C3E.raft-rs.impl_correct_2_3_1_fifo.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.omnipaxos-derived.spec_correct_2_3_1_fifo.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.raft-rs.impl_correct_2_3_1_fifo.t16.cinf.r2/export.jsonl
