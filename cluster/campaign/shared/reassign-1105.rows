# Study rows of the unreachable pinky17 and pinky23 (2026-11-05), reassigned to a healthy capped node (owner starts it with start-shared-queue.sh).
# Left behind on purpose: election 11, two-pc-lbinria 7/8, replicated-log-aneris 10 (appendix only) and the zab size-4 rows (dropped).
C3E.pineapple-paper-rust.impl_2_fifo.t16.c48h 250 172800 "$DAAVAR"/scripts/rust-run.sh pineapple-paper-rust export impl --out export.jsonl --threads 16 --model fifo -- 2
C3E.swiftpaxos-paper-rust-sol.impl_2_fifo.t16.c48h 250 172800 "$DAAVAR"/scripts/rust-run.sh swiftpaxos-paper-rust-sol export impl --out export.jsonl --threads 16 --model fifo -- 2
C3J.swiftpaxos-paper-rust-sol.impl_2_fifo.vs-derived.c48h.m 250 172800 needok:C3E.swiftpaxos-paper-rust-sol.impl_2_fifo.t16.c48h "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/imports/C3E.swiftpaxos-derived.spec_2_fifo.t16.c48h/export.jsonl "$EVAL_OUT"/C3E.swiftpaxos-paper-rust-sol.impl_2_fifo.t16.c48h/export.jsonl
XJE.zab-broadcast-remix.spec_3_fifo.w16 250 172800 "$DAAVAR"/scripts/jmc-run.sh zab-broadcast-remix 'bench.zab_broadcast_remix.ZabBroadcast:spec,3,fifo' must 0 1 export.jsonl 172800 --split 16 --k 1
XON2.zab-broadcast-remix.impl_3_fifo_correct.t16 250 172800 needok:XJE.zab-broadcast-remix.spec_3_fifo.w16 "$DAAVAR"/scripts/rust-run.sh zab-broadcast-remix online --threads 16 --model fifo --spec "$EVAL_OUT"/XJE.zab-broadcast-remix.spec_3_fifo.w16/export.jsonl -- 3 correct
XON2.zab-broadcast-remix.impl_3_fifo_issue1-propose-to-ackld.t16 250 172800 needok:XJE.zab-broadcast-remix.spec_3_fifo.w16 "$DAAVAR"/scripts/rust-run.sh zab-broadcast-remix online --threads 16 --model fifo --spec "$EVAL_OUT"/XJE.zab-broadcast-remix.spec_3_fifo.w16/export.jsonl -- 3 issue1-propose-to-ackld
