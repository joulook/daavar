# ZooKeeper transliteration (zookeeper-zab, Java) at (1,0) against S_raft, S_zab and the two Rust ports, both directions, rerun on brain09 (owner 2026-11-06:
# the .r2 rows were killed or skipped); every export it needs is run here first
C3E.omnipaxos.spec_correct_1_1_1_fifo.t16.c48h 250 172800 "$DAAVAR"/scripts/rust-run.sh omnipaxos export spec --out export.jsonl --threads 16 --model fifo -- correct 1 1 1
