# Offline substitutes for the Online (XON2) rows of Phases B-D dropped on 2026-11-06 (owner: no Online evaluation in B-D; an Offline
# check of the same pair and size replaces each one that had none). Exports first (48 h), then the merge join. Node: brain08 (owner 11-06).
# brain08 has no earlier exports of these ids, so every export is run here, the JMC specification exports once per (program, size).
XJE.election.spec_ring_conf_11_fifo.w16 250 172800 "$DAAVAR"/scripts/jmc-run.sh election 'bench.election.Election:spec,11,fifo' must 0 1 export.jsonl 172800 --split 16 --k 1
C3E.election.impl_ring_split_11_fifo.t16 250 172800 "$DAAVAR"/scripts/rust-run.sh election export impl --out export.jsonl --threads 16 --model fifo -- ring split 11
XJ2.election.impl_ring_split_11_fifo.vs-ring-conf.jmcspec-tfimpl.c48h.m 250 172800 needok:XJE.election.spec_ring_conf_11_fifo.w16,C3E.election.impl_ring_split_11_fifo.t16 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XJE.election.spec_ring_conf_11_fifo.w16/export.jsonl "$EVAL_OUT"/C3E.election.impl_ring_split_11_fifo.t16/export.jsonl
C3E.election.impl_ring_conf_11_fifo.t16 250 172800 "$DAAVAR"/scripts/rust-run.sh election export impl --out export.jsonl --threads 16 --model fifo -- ring conf 11
