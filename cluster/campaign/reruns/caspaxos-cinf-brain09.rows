# CasPaxos (3,2, bag) Offline without a time limit (owner 2026-11-06 19:50): .cinf = 8640000 s; brain09 after its shared queue;
# the JMC export runs with JAVA_TOOL_OPTIONS=-Xmx60g (17 JVMs, <= ~1 TB in total; the 4 h run grew ~28 GB/h). Moved from brain03 (dropped there).
C3E.caspaxos.spec_3_2_bag.t16.cinf 250 8640000 "$DAAVAR"/scripts/rust-run.sh caspaxos export spec --out export.jsonl --threads 16 --model bag -- 3 2
C3E.caspaxos.impl_3_2_bag.t16.cinf 250 8640000 "$DAAVAR"/scripts/rust-run.sh caspaxos export impl --out export.jsonl --threads 16 --model bag -- 3 2
C3J.caspaxos.impl_3_2_bag.cinf.m 250 8640000 needok:C3E.caspaxos.spec_3_2_bag.t16.cinf,C3E.caspaxos.impl_3_2_bag.t16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.spec_3_2_bag.t16.cinf/export.jsonl "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf/export.jsonl
XCE.caspaxos.impl_3_2_bag.w16.cinf 250 8640000 env JAVA_TOOL_OPTIONS=-Xmx60g "$DAAVAR"/scripts/jmc-run.sh cf-caspaxos 'bench.caspaxos.CasPaxos:impl,3,2,bag' must 0 1 export.jsonl 8640000 --split 16 --k 1
XJ1.caspaxos.impl_3_2_bag.tfspec-jmcimpl.cinf.m 250 8640000 needok:C3E.caspaxos.spec_3_2_bag.t16.cinf,XCE.caspaxos.impl_3_2_bag.w16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.spec_3_2_bag.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf/export.jsonl
XC1.caspaxos.impl_3_2_bag.jimpl-tfimpl.cinf.m 250 8640000 needok:XCE.caspaxos.impl_3_2_bag.w16.cinf,C3E.caspaxos.impl_3_2_bag.t16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf/export.jsonl "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf/export.jsonl
XC2.caspaxos.impl_3_2_bag.tfimpl-jimpl.cinf.m 250 8640000 needok:C3E.caspaxos.impl_3_2_bag.t16.cinf,XCE.caspaxos.impl_3_2_bag.w16.cinf "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf/export.jsonl "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf/export.jsonl
