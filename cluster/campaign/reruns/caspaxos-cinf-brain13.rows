# CASPaxos (3,2) without a time limit, moved from brain09 (ours only until 2026-11-10 23:59; owner stopped its queue 2026-11-09 09:55) to brain13 as reruns .r2. Half the machine, wait on foreign load.
C3E.caspaxos.spec_3_2_bag.t16.cinf.r2 250 8640000 "$DAAVAR"/scripts/rust-run.sh caspaxos export spec --out export.jsonl --threads 16 --model bag -- 3 2
C3E.caspaxos.impl_3_2_bag.t16.cinf.r2 250 8640000 "$DAAVAR"/scripts/rust-run.sh caspaxos export impl --out export.jsonl --threads 16 --model bag -- 3 2
C3J.caspaxos.impl_3_2_bag.cinf.r2.m 250 8640000 needok:C3E.caspaxos.spec_3_2_bag.t16.cinf.r2,C3E.caspaxos.impl_3_2_bag.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.spec_3_2_bag.t16.cinf.r2/export.jsonl "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf.r2/export.jsonl
XCE.caspaxos.impl_3_2_bag.w16.cinf.r2 250 8640000 env JAVA_TOOL_OPTIONS=-Xmx60g "$DAAVAR"/scripts/jmc-run.sh cf-caspaxos 'bench.caspaxos.CasPaxos:impl,3,2,bag' must 0 1 export.jsonl 8640000 --split 16 --k 1
XJ1.caspaxos.impl_3_2_bag.tfspec-jmcimpl.cinf.r2.m 250 8640000 needok:C3E.caspaxos.spec_3_2_bag.t16.cinf.r2,XCE.caspaxos.impl_3_2_bag.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.spec_3_2_bag.t16.cinf.r2/export.jsonl "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf.r2/export.jsonl
XC1.caspaxos.impl_3_2_bag.jimpl-tfimpl.cinf.r2.m 250 8640000 needok:XCE.caspaxos.impl_3_2_bag.w16.cinf.r2,C3E.caspaxos.impl_3_2_bag.t16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf.r2/export.jsonl "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf.r2/export.jsonl
XC2.caspaxos.impl_3_2_bag.tfimpl-jimpl.cinf.r2.m 250 8640000 needok:C3E.caspaxos.impl_3_2_bag.t16.cinf.r2,XCE.caspaxos.impl_3_2_bag.w16.cinf.r2 "$EVAL_OUT"/tf-merge-target/release/conf-join --merge "$EVAL_OUT"/C3E.caspaxos.impl_3_2_bag.t16.cinf.r2/export.jsonl "$EVAL_OUT"/XCE.caspaxos.impl_3_2_bag.w16.cinf.r2/export.jsonl
